{"translation-revision-date":"2026-10-06 12:24+0900","generator":"WP-CLI\/2.12.0","source":"build\/blocks\/contactmail-sender\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=2; plural=(n != 1);"},"Margin settings(mobile)":["\u30de\u30fc\u30b8\u30f3\u8a2d\u5b9a(\u30e2\u30d0\u30a4\u30eb)"],"Margin settings(desk top)":["\u30de\u30fc\u30b8\u30f3\u8a2d\u5b9a(\u30c7\u30b9\u30af\u30c8\u30c3\u30d7)"],"Padding settings(mobile)":["\u30d1\u30c7\u30a3\u30f3\u30b0\u8a2d\u5b9a(\u30e2\u30d0\u30a4\u30eb)"],"Padding settings(desk top)":["\u30d1\u30c7\u30a3\u30f3\u30b0\u8a2d\u5b9a(\u30c7\u30b9\u30af\u30c8\u30c3\u30d7)"],"Is Shadow":["\u30b7\u30e3\u30c9\u30fc\u3092\u3064\u3051\u308b"],"This is a block for setting up an inquiry form.":["\u304a\u554f\u3044\u5408\u308f\u305b\u30d5\u30a9\u30fc\u30e0\u3092\u8a2d\u7f6e\u3059\u308b\u305f\u3081\u306e\u30d6\u30ed\u30c3\u30af\u3067\u3059\u3002"],"We have received an inquiry.":["\u304a\u554f\u3044\u5408\u308f\u305b\u3092\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002"],"We have received an inquiry regarding the following information.":["\u4e0b\u8a18\u306e\u5185\u5bb9\u306e\u3068\u304a\u308a\u304a\u554f\u3044\u5408\u308f\u305b\u3092\u53d7\u3051\u4ed8\u3051\u3066\u304a\u308a\u307e\u3059\u3002"],"Thank you for contacting us.":["\u304a\u554f\u5408\u305b\u3044\u305f\u3060\u304d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002"],"We have received your inquiry with the following details.":["\u4ee5\u4e0b\u306e\u5185\u5bb9\u3067\u304a\u554f\u3044\u5408\u308f\u305b\u3092\u53d7\u3051\u4ed8\u3051\u3066\u304a\u308a\u307e\u3059\u3002"],"The person in charge has been notified of your inquiry. Please wait for a while until we reply.":["\u304a\u554f\u3044\u5408\u308f\u305b\u5185\u5bb9\u306f\u62c5\u5f53\u8005\u306b\u901a\u77e5\u3055\u308c\u307e\u3057\u305f\u3002 \u8fd4\u4fe1\u307e\u3067\u3057\u3070\u3089\u304f\u304a\u5f85\u3061\u304f\u3060\u3055\u3044\u3002"],"Email notification to the person in charge failed.":["\u62c5\u5f53\u8005\u3078\u306e\u30e1\u30fc\u30eb\u901a\u77e5\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002"],"We have sent an automatic response email to you, so please check it.":["\u81ea\u52d5\u8fd4\u4fe1\u30e1\u30fc\u30eb\u3092\u304a\u9001\u308a\u3057\u3066\u304a\u308a\u307e\u3059\u306e\u3067\u3054\u78ba\u8a8d\u4e0b\u3055\u3044\u3002"],"Failed to send automatic response email to you.":["\u81ea\u52d5\u8fd4\u4fe1\u30e1\u30fc\u30eb\u306e\u9001\u4fe1\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002"],"Inquiry information notification email":["\u304a\u554f\u3044\u5408\u308f\u305b\u60c5\u5831\u901a\u77e5\u30e1\u30fc\u30eb"],"Notification email address (Master)":["\u901a\u77e5\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\uff08\u7ba1\u7406\u8005\uff09"],"The notification email address is blank or has an invalid format. ":["\u901a\u77e5\u96fb\u5b50\u30e1\u30fc\u30eb \u30a2\u30c9\u30ec\u30b9\u304c\u7a7a\u767d\u3067\u3042\u308b\u304b\u3001\u7121\u52b9\u306a\u5f62\u5f0f\u3067\u3059\u3002"],"Master Name":["\u7ba1\u7406\u8005\u540d"],"Do not leave the master name blank. ":["\u7ba1\u7406\u8005\u540d\u306f\u7a7a\u767d\u306e\u307e\u307e\u306b\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"],"Notification email subject":["\u901a\u77e5\u30e1\u30fc\u30eb\u306e\u4ef6\u540d"],"Do not leave the subject of the notification email blank. ":["\u901a\u77e5\u30e1\u30fc\u30eb\u306e\u4ef6\u540d\u306f\u7a7a\u767d\u306e\u307e\u307e\u306b\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"],"Notification email body":["\u901a\u77e5\u30e1\u30fc\u30eb\u306e\u672c\u6587"],"Do not leave the body of the notification email blank. ":["\u901a\u77e5\u30e1\u30fc\u30eb\u306e\u672c\u6587\u306f\u7a7a\u767d\u306e\u307e\u307e\u306b\u3057\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"],"Automatic response email":["\u81ea\u52d5\u8fd4\u4fe1\u30e1\u30fc\u30eb"],"Send automatic response email":["\u81ea\u52d5\u8fd4\u4fe1\u30e1\u30fc\u30eb\u3092\u9001\u4fe1\u3059\u308b"],"Reply to email address":["\u8fd4\u4fe1\u5148\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9"],"Automatic response email title":["\u81ea\u52d5\u8fd4\u4fe1\u30e1\u30fc\u30eb\u306e\u4ef6\u540d"],"Automatic response email body":["\u81ea\u52d5\u8fd4\u4fe1\u30e1\u30fc\u30eb\u672c\u6587"],"Click on the input field below to quote it in the text.":["\u672c\u6587\u4e2d\u3067\u5f15\u7528\u3059\u308b\u306b\u306f\u4e0b\u306e\u5165\u529b\u30d5\u30a3\u30fc\u30eb\u30c9\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Send Data Save setting":["\u9001\u4fe1\u30c7\u30fc\u30bf\u4fdd\u5b58\u8a2d\u5b9a"],"Save response contents to DB":["\u5fdc\u7b54\u5185\u5bb9\u3092\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u306b\u4fdd\u5b58"],"Save Post Type":["\u4fdd\u5b58\u6295\u7a3f\u30bf\u30a4\u30d7"],"Please enter the post type name to identify the data you want to save.":["\u4fdd\u5b58\u3057\u305f\u3044\u30c7\u30fc\u30bf\u3092\u8b58\u5225\u3059\u308b\u305f\u3081\u306b\u3001\u6295\u7a3f\u30bf\u30a4\u30d7\u540d\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Export the inquiry data as a CSV file.":["\u554f\u3044\u5408\u308f\u305b\u30c7\u30fc\u30bf\u3092CSV\u30d5\u30a1\u30a4\u30eb\u3068\u3057\u3066\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u3057\u307e\u3059\u3002"],"Download CSV":["\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9CSV"],"Space settings":["\u7a7a\u767d\u8a2d\u5b9a"],"Shadow settings":["\u30b7\u30e3\u30c9\u30fc\u8a2d\u5b9a"],"[master_name] and [master_mail] are replaced with the sender name and address when the email is sent.":["[master_name] \u3068 [master_mail] \u306f\u3001\u9001\u4fe1\u6642\u306b\u5dee\u51fa\u4eba\u540d\u3068\u5dee\u51fa\u4eba\u30a2\u30c9\u30ec\u30b9\u306b\u7f6e\u304d\u63db\u308f\u308a\u307e\u3059\u3002"],"Clear block-specific settings":["\u500b\u5225\u8a2d\u5b9a\u3092\u89e3\u9664"],"This block has its own destination saved, which takes priority over the site setting.":["\u3053\u306e\u30d6\u30ed\u30c3\u30af\u306b\u306f\u500b\u5225\u306e\u9001\u4fe1\u5148\u304c\u4fdd\u5b58\u3055\u308c\u3066\u3044\u307e\u3059\uff08\u30b5\u30a4\u30c8\u8a2d\u5b9a\u3088\u308a\u512a\u5148\uff09\u3002"],"These settings are shared by every inquiry form on this site and are saved with the site, not with this block.":["\u3053\u306e\u8a2d\u5b9a\u306f\u30b5\u30a4\u30c8\u5185\u306e\u3059\u3079\u3066\u306e\u554f\u3044\u5408\u308f\u305b\u30d5\u30a9\u30fc\u30e0\u3067\u5171\u901a\u3067\u3059\u3002\u30d6\u30ed\u30c3\u30af\u3067\u306f\u306a\u304f\u30b5\u30a4\u30c8\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"],"Only administrators can change the site's inquiry mail settings.":["\u554f\u3044\u5408\u308f\u305b\u30e1\u30fc\u30eb\u306e\u30b5\u30a4\u30c8\u8a2d\u5b9a\u3092\u5909\u66f4\u3067\u304d\u308b\u306e\u306f\u7ba1\u7406\u8005\u3060\u3051\u3067\u3059\u3002"],"Send":["\u9001\u4fe1"],"Please check your input":["\u5165\u529b\u5185\u5bb9\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044"],"Back to input":["\u5165\u529b\u753b\u9762\u306b\u623b\u308b"],"Return to home":["\u30db\u30fc\u30e0\u3078\u623b\u308b"],"Mail subject and body":["\u30e1\u30fc\u30eb\u306e\u4ef6\u540d\u3068\u672c\u6587"],"The subject and body of the notification and automatic response emails are set in the Confirm Figure block, under \"Input screens and mail settings\".":["\u901a\u77e5\u30e1\u30fc\u30eb\u3068\u81ea\u52d5\u8fd4\u4fe1\u30e1\u30fc\u30eb\u306e\u4ef6\u540d\u30fb\u672c\u6587\u306f\u3001Confirm Figure \u30d6\u30ed\u30c3\u30af\u306e\u300c\u5165\u529b\u753b\u9762\u3068\u30e1\u30fc\u30eb\u306e\u8a2d\u5b9a\u300d\u3067\u8a2d\u5b9a\u3057\u307e\u3059\u3002"],"The mail settings appear only when a button on the input screen has a button identification key.":["\u30e1\u30fc\u30eb\u306e\u8a2d\u5b9a\u306f\u3001\u5165\u529b\u753b\u9762\u306e\u30dc\u30bf\u30f3\u306b\u300c\u30dc\u30bf\u30f3\u8b58\u5225\u30ad\u30fc\u300d\u304c\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u308b\u3068\u304d\u3060\u3051\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"Select the Confirm Figure block":["Confirm Figure \u30d6\u30ed\u30c3\u30af\u3092\u9078\u629e"],"Master Mail":["\u5dee\u51fa\u4eba\u30a2\u30c9\u30ec\u30b9"],"Input Value":["\u5165\u529b\u5024"],"Logon User":["\u30ed\u30b0\u30a4\u30f3\u30e6\u30fc\u30b6\u30fc"],"Add Mail Footer":["\u30e1\u30fc\u30eb\u306b\u30d5\u30c3\u30bf\u30fc\u3092\u4ed8\u3051\u308b"],"Footer Content":["\u30d5\u30c3\u30bf\u30fc\u306e\u5185\u5bb9"],"The email address format is invalid. ":["\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u306e\u5f62\u5f0f\u304c\u6b63\u3057\u304f\u3042\u308a\u307e\u305b\u3093\u3002"]}}}